# Dependencies and build caches
node_modules/
/.astro/
/.cache/
/.vite/
*.tsbuildinfo

# Build output and generated media (keep directory placeholders)
/dist/
/coverage/
/src/generated/*
!/src/generated/.gitkeep
/public/resource/*
!/public/resource/.gitkeep

# Local environment files; allow a shareable template
.env
.env.*
!.env.example
*.local

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.swo
*.bak
*~

# Editor and operating-system metadata
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# Keep resource images, Markdown, JSON, SVG and package-lock.json tracked.
