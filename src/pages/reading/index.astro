---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { readingEntries } from '../../lib/content';
const entries = await readingEntries();
---
<BaseLayout title="读书与思考">
  <header class="page-heading"><p class="eyebrow">READING & REFLECTIONS</p><h1>读书与思考</h1><p>记下读过的文字，也记下自己的想法。</p></header>
  <ArticleList entries={entries} />
</BaseLayout>
