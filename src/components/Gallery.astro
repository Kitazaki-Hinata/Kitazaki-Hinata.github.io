---
import { resourceUrl } from '../lib/urls';
import type { GalleryImage } from '../lib/media';
import Thumbnail from './Thumbnail.astro';
import ImageViewer from './ImageViewer.astro';
interface Props { images: GalleryImage[]; activation?: 'single' | 'double'; showCaptions?: boolean; showOriginalLinks?: boolean }
const { images, activation = 'single', showCaptions = true, showOriginalLinks = true } = Astro.props;
---
{images.length ? (
  <section data-gallery data-activation={activation}>
    {activation === 'double' && <p>电脑双击图片查看原图；触屏轻点打开，也可选中图片后按 Enter。</p>}
    <div class="gallery">
      {images.map((image, index) => (
        <figure class="panel gallery-item">
          <a href={resourceUrl(image.src)} data-gallery-image data-index={index} data-title={image.title} data-alt={image.alt}
            target="_blank" rel="noopener noreferrer" aria-label={'查看原图：' + image.title}>
            <Thumbnail source={image} alt={image.alt} />
          </a>
          {showCaptions && <figcaption>
            <h2>{image.title}</h2>
            {image.description && <p>{image.description}</p>}
            {showOriginalLinks && <a href={resourceUrl(image.src)} data-view-image data-index={index} target="_blank" rel="noopener noreferrer">查看原图 ↗</a>}
          </figcaption>}
        </figure>
      ))}
    </div>
    <ImageViewer />
  </section>
) : <p class="panel empty">这里还没有图片，之后再来看看。</p>}
<style>
  [data-gallery-image] { display: block; }
  [data-gallery-image]:focus-visible { outline-offset: -5px; }
  figcaption h2 { margin-top: 0; }
  figcaption p { line-height: 1.8; }
  figcaption > a { font-size: .9rem; font-weight: 700; }
</style>
