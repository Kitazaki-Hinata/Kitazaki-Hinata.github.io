---
import type { CollectionEntry } from 'astro:content';
import { entryDate, entrySummary, entryTitle } from '../lib/content';
import { withBase } from '../lib/urls';
interface Props { entries: CollectionEntry<'stock' | 'reading'>[] }
const { entries } = Astro.props;
const categories = [...new Set(entries.map((entry) => entry.data.category))].sort();
---
<section data-article-filter>
  <div data-filter-controls hidden>
    <label>分类 <select aria-label="分类"><option value="">全部</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
    <p data-filter-status role="status"></p>
  </div>
<div class="article-list">
  {entries.map((entry) => (
    <article class="panel" data-category={entry.data.category}>
      <div class="meta"><span>{entry.data.category}</span><span>{entryDate(entry) || '未注明日期'}</span></div>
      <h2><a href={withBase('/' + entry.collection + '/' + entry.id + '/')}>{entryTitle(entry)}</a></h2>
      <p>{entrySummary(entry)}</p>
    </article>
  ))}
  {!entries.length && <p class="panel empty">还没有发布记录。</p>}
</div>
<p data-filter-empty hidden>这个分类暂时没有记录。</p>
</section>
<script>
  import '../scripts/article-filter';
</script>
<style>
  [data-filter-controls]:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  label { display: flex; align-items: center; gap: .75rem; font-weight: 700; }
  select {
    max-width: 100%;
    min-height: 44px;
    padding: .5rem 2rem .5rem .9rem;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--glass-bg);
    color: var(--ink);
    box-shadow: 0 4px 14px rgba(45, 76, 101, .12);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    font: inherit;
    cursor: pointer;
  }
  select:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  option { background: #edf4fc; color: var(--ink); }
  [data-filter-status] { margin: 0; font-size: .9rem; }
  article h2 { margin: .75rem 0; }
  article h2 a { text-decoration: none; }
  article h2 a:hover { text-decoration: underline; }
  article p { margin-bottom: 0; }
</style>
