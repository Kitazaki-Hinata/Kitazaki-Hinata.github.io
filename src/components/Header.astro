---
import { siteConfig } from '../config/site';
import { withBase } from '../lib/urls';
const current = Astro.url.pathname;
const active = (href: string) => {
  const url = withBase(href);
  return href === '/' ? current === url
    : current.startsWith(url) || (href === '/osu/' && current.startsWith(withBase('/osu_skin/')));
};
---
<header class="site-header">
  <div class="site-shell header-inner">
    <a class="brand" href={withBase('/')}>{siteConfig.title}</a>
    <nav aria-label="主导航">
      {siteConfig.navigation.map((item) =>
        <a href={withBase(item.href)} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>
      )}
    </nav>
  </div>
</header>
<script is:inline>
  // Reserve the actual navigation height, including wrapped links and loaded fonts.
  (() => {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const updateHeight = () => {
      document.documentElement.style.setProperty('--header-offset', header.getBoundingClientRect().height + 'px');
    };
    updateHeight();
    new ResizeObserver(updateHeight).observe(header);
  })();
</script>
