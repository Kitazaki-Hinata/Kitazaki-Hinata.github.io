---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { resourceUrl, withBase } from '../lib/urls';
const about = await getEntry('about', 'about');
const rendered = about ? await render(about) : undefined;
const About = rendered?.Content;
---
<BaseLayout home>
  <section class="hero home-hero" aria-labelledby="hero-title">
    <p class="eyebrow">日向北崎的博客 · Personal Space</p>
    <h1 id="hero-title">{siteConfig.title}</h1>
    <p class="hero-description">
      <span>记录一些Hinata喜欢的东西</span>
      <span>如果你不是Hinata，那么欢迎你的到来！（只有我会告诉你其实这个博客只有Hinata在认真的看ww）</span>
      <span lang="en">Welcome to Kitazaki Hinata’s Personal Space</span>
    </p>
    <div class="hero-links">
      <a class="button" href="#about">认识一下 ↓</a>
      <a class="text-link" href={withBase('/osu/')}>浏览osu skin</a>
    </div>
  </section>
  <section id="about" class="panel about-section">
    <img class="avatar" src={resourceUrl(siteConfig.avatar)} alt={siteConfig.title + ' 的头像'} width="120" height="120" />
    <div class="prose">{About ? <About /> : <p>自我介绍正在整理中。</p>}</div>
  </section>
</BaseLayout>
