---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkinCard from '../../components/SkinCard.astro';
import { media } from '../../lib/media';
---
<BaseLayout title="皮肤设计展示">
  <header class="page-heading">
    <p class="eyebrow">OSU! COLLECTION</p>
    <h1>皮肤设计展示</h1>
    <p>她所有完成的和在做的skin (定制skin需向她投喂35元)</p>
  </header>
  <div class="card-grid">{media.skins.map((skin) => <SkinCard skin={skin} />)}</div>
  {!media.skins.length && <p class="panel empty">还没有发布 skin。</p>}
</BaseLayout>
